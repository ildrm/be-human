    "@nestjs/platform-fastify": "11.1.28",
    "@nestjs/swagger": "11.4.7",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "fastify": "5.12.5",
    "pg": "8.16.3",
